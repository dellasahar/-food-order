{
    "name": "my-project",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev -H 0.0.0.0 -p 3000",
        "build": "next build",
        "start": "next start",
        "test": "vitest run",
        "test:unit": "vitest run tests/unit",
        "test:api": "vitest run tests/api",
        "test:bdd": "cucumber-js --require-module tsx/cjs --require 'tests/steps/**/*.ts' 'tests/features/**/*.feature'",
        "test:e2e": "cypress run",
        "test:e2e:open": "cypress open",
        "test:all": "pnpm test:unit && pnpm test:api && pnpm test:bdd",
        "test:e2e:ci": "start-server-and-test dev http://localhost:3000 test:e2e",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:seed": "prisma db seed"
    },
    "dependencies": {
        "@base-ui/react": "^1.5.0",
        "@prisma/client": "^6.19.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.16.0",
        "next": "16.3.0",
        "react": "^19",
        "react-dom": "^19",
        "shadcn": "^4.8.0",
        "tailwind-merge": "^3.3.1",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@cucumber/cucumber": "^13.2.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^24",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "cypress": "^15.21.0",
        "postcss": "^8.5",
        "prisma": "^6.19.3",
        "start-server-and-test": "^3.0.12",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.12",
        "typescript": "5.7.3",
        "vitest": "^4.1.11"
    }
}